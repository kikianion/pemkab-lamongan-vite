# Copy to .env.local. Debug overlay levels:
#   false / unset = off
#   true (or 1)   = level 1: outline all elements, labels tag#id.class, hover info
#   2             = level 2: only elements with class "debug2", label shows #id at top-left
VITE_DEBUG_UI=false

# Car animation on the map road:
#   true / unset = car drives left to right (loop)
#   false (or 0/off) = animation disabled, car parked at initial position
VITE_CAR_ANIMATION=true

# Delay in milliseconds after page load before the map intro animation starts (default 2000)
VITE_MAP_INTRO_DELAY=2000

# Duration in milliseconds of the map intro animation: zoom, rotate and fade in (default 2000)
VITE_MAP_INTRO_DURATION=2000

# Starting rotation angle in degrees of the map intro animation, rotates to 0 (default -45)
VITE_MAP_INTRO_ANGLE=-45
