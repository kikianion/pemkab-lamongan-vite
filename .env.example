# Copy to .env.local. Debug overlay levels:
#   false / unset = off
#   true (or 1)   = level 1: outline all elements, labels tag#id.class, hover info
#   2             = level 2: only elements with class "debug2", label shows #id at top-left
VITE_DEBUG_UI=false

# Car animation on the map road:
#   true / unset = car drives left to right (loop)
#   false (or 0/off) = animation disabled, car parked at initial position
VITE_CAR_ANIMATION=true
